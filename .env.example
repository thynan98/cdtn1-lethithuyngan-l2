# Kết nối MongoDB khi chạy bằng Python (cách 2 trong README): MongoDB cài trên máy hoặc chuỗi kết nối Atlas.
# Chạy bằng Docker (cách 1) thì không cần file này.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=warranty

# Khóa ký đăng nhập (JWT). Đổi thành chuỗi ngẫu nhiên dài ít nhất 32 ký tự khi dùng thật.
JWT_SECRET=doi-thanh-chuoi-bi-mat-cua-ban
JWT_EXPIRE_MINUTES=480

# Mức log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO