# Kết nối MongoDB khi chạy bằng Python (cách 2 trong README): MongoDB cài trên máy hoặc chuỗi kết nối Atlas.
# Chạy bằng Docker (cách 1): chỉ cần JWT_SECRET trong file .env (cp .env.example .env).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=warranty

# Khóa ký đăng nhập (JWT), bắt buộc, ít nhất 32 ký tự. Giá trị dưới đây chỉ để chạy thử;
# khi dùng thật hãy sinh khóa riêng:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=chay-thu-doi-khoa-nay-khi-dung-that-0123456789
JWT_EXPIRE_MINUTES=480

# Mức log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO