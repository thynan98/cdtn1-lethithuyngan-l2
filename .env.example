# Kết nối MongoDB. Mặc định trỏ vào MongoDB chạy bằng docker compose hoặc cài cục bộ.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=warranty

# Khóa ký đăng nhập (JWT). Đổi thành chuỗi ngẫu nhiên dài ít nhất 32 ký tự khi dùng thật.
JWT_SECRET=doi-thanh-chuoi-bi-mat-cua-ban
JWT_EXPIRE_MINUTES=480

# Mức log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
